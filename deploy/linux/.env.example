COMPOSE_PROJECT_NAME=scm-platform
TZ=Asia/Shanghai
SCM_DATA_ROOT=/opt/scm-platform/data
DEPLOY_TIMEOUT_SECONDS=600

MYSQL_IMAGE=mysql:8.0.36
MYSQL_ROOT_PASSWORD=__MYSQL_ROOT_PASSWORD__
MYSQL_APP_USER=scm_app
MYSQL_APP_PASSWORD=__MYSQL_APP_PASSWORD__
MYSQL_PORT=3306

REDIS_IMAGE=redis:7.2.5-alpine
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_PORT=6379

ROCKETMQ_IMAGE=apache/rocketmq:5.3.2
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_FAST_PORT=10909

NACOS_IMAGE=nacos/nacos-server:v2.3.2
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_GRPC_RAFT_PORT=9849
NACOS_AUTH_IDENTITY_KEY=__NACOS_IDENTITY_KEY__
NACOS_AUTH_IDENTITY_VALUE=__NACOS_IDENTITY_VALUE__
NACOS_AUTH_TOKEN=__NACOS_AUTH_TOKEN__

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=__MINIO_ROOT_USER__
MINIO_ROOT_PASSWORD=__MINIO_ROOT_PASSWORD__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

JENKINS_IMAGE=jenkins/jenkins:lts-jdk21
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000

NGINX_IMAGE=nginx:1.26.3-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
